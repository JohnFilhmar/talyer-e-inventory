# Copy to .env.local for local dev. Only EXPO_PUBLIC_* is readable from app code
# (constants/env.ts), and Expo INLINES these at bundle time — a change needs a
# restart with a cleared cache (npx expo start -c), and in EAS they belong in the
# profile env / EAS environment variables, not a committed file.

# Must include the /api suffix — the backend mounts every router under /api/*.
# Android emulator reaches the host at 10.0.2.2; a physical device needs the LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:5000/api

EXPO_PUBLIC_APP_VARIANT=development
EXPO_PUBLIC_ENABLE_REALTIME=false
